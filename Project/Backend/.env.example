PORT=3000
CORS_ORIGIN=http://localhost:8000

# Gemini keys. At least GOOGLE_GEMINI_KEY_1 is required.
GOOGLE_GEMINI_KEY_1=your_gemini_key
GOOGLE_GEMINI_KEY_2=
GOOGLE_GEMINI_KEY_3=

# Research paper APIs.
# ScrapingDog is the primary provider.
SCRAPINGDOG_API_KEY=your_scrapingdog_key

# OpenAlex works without a key. Supplying an email is recommended for polite pool access.
OPENALEX_MAILTO=your_email@example.com

# Semantic Scholar works without a key for low-volume usage. Add a key if available.
SEMANTIC_SCHOLAR_API_KEY=

# Optional because Firebase is the selected app data store.
MONGODB_URI=

# Optional safety tuning.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
PAPER_SESSION_TTL_MS=3600000
MAX_PAPER_SESSIONS=25
